#Networking
#Socket
import socket
s = socket.socket()
print("Socket successfully created")
port = 9999
host = socket.gethostname()
s.bind((host, port))
print("Socket binded to", port)
s.listen(3)
print("Socket is listening...")
while True:
    c, addr = s.accept()
    print("Got connection from", addr)
    c.send(b"Thank you for connecting")
    c.close()

